[Unit]
Description=Keel Outline encrypted proxy
Wants=network-online.target
After=network-online.target

[Service]
DynamicUser=yes
User=keeloutline
Group=keeloutline
LoadCredential=server:/etc/keel-outline/server.yaml
ExecStart=/usr/local/bin/outline-ss-server -config %d/server -metrics 127.0.0.1:9091 -replay_history=10000
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
