[Unit]
Description=Keel read-only device traffic viewer
Requires=keel-traffic-collector.service
After=keel-traffic-collector.service

[Service]
Type=simple
User=ssmanager
Group=ssmanager
WorkingDirectory=/opt/keel
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m keel.traffic serve --mapping /etc/keel/traffic.json --database /var/lib/keel-traffic/traffic.db --port 8766
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/keel-traffic
InaccessiblePaths=/run/ssmanager /run/keel-traffic
RestrictAddressFamilies=AF_INET
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
