[Unit]
Description=Keel ssmanager device traffic collector
Requires=ssmanager.service
After=ssmanager.service

[Service]
Type=simple
User=ssmanager
Group=ssmanager
WorkingDirectory=/opt/keel
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m keel.traffic collect --mapping /etc/keel/traffic.json --database /var/lib/keel-traffic/traffic.db --runtime-dir /run/keel-traffic
Restart=on-failure
RestartSec=5s
UMask=0077
StateDirectory=keel-traffic
StateDirectoryMode=0700
RuntimeDirectory=keel-traffic
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/keel-traffic /run/keel-traffic
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
