[Unit]
Description=Keel loopback Clash subscription server with live subscription-userinfo headers
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
ExecStart=/usr/local/bin/keel-sub-server
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
ReadOnlyPaths=/var/lib/keel-sub /var/lib/keel-quota
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
